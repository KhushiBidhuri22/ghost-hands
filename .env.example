# --- Gemini Planner ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=15

# Set to 1 to skip Gemini entirely and use the rule-based planner (offline / demo safety net)
FORCE_FALLBACK=0
PLAN_CACHE_FILE=.plan_cache.json

# --- Server ---
BACKEND_PORT=8000

